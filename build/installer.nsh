; Registers Slate Office with Windows so it appears under "Open with" and in Settings > Default apps.
; electron-builder creates the SlateOffice.<ext> ProgIDs; this adds the capability records Windows needs.

!macro customInstall
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe" "FriendlyAppName" "Slate Office"
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\shell\open\command" "" '"$INSTDIR\Slate Office.exe" "%1"'
  WriteRegStr HKCU "Software\SlateOffice\Capabilities" "ApplicationName" "Slate Office"
  WriteRegStr HKCU "Software\SlateOffice\Capabilities" "ApplicationDescription" "Offline office suite: PDFs, documents, spreadsheets and presentations."
  WriteRegStr HKCU "Software\RegisteredApplications" "Slate Office" "Software\SlateOffice\Capabilities"
  WriteRegStr HKCU "Software\Classes\.pdf\OpenWithProgids" "SlateOffice.pdf" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".pdf" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".pdf" "SlateOffice.pdf"
  WriteRegStr HKCU "Software\Classes\.docx\OpenWithProgids" "SlateOffice.docx" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".docx" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".docx" "SlateOffice.docx"
  WriteRegStr HKCU "Software\Classes\.doc\OpenWithProgids" "SlateOffice.doc" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".doc" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".doc" "SlateOffice.doc"
  WriteRegStr HKCU "Software\Classes\.odt\OpenWithProgids" "SlateOffice.odt" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".odt" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".odt" "SlateOffice.odt"
  WriteRegStr HKCU "Software\Classes\.rtf\OpenWithProgids" "SlateOffice.rtf" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".rtf" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".rtf" "SlateOffice.rtf"
  WriteRegStr HKCU "Software\Classes\.html\OpenWithProgids" "SlateOffice.html" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".html" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".html" "SlateOffice.html"
  WriteRegStr HKCU "Software\Classes\.xlsx\OpenWithProgids" "SlateOffice.xlsx" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".xlsx" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".xlsx" "SlateOffice.xlsx"
  WriteRegStr HKCU "Software\Classes\.xls\OpenWithProgids" "SlateOffice.xls" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".xls" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".xls" "SlateOffice.xls"
  WriteRegStr HKCU "Software\Classes\.ods\OpenWithProgids" "SlateOffice.ods" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".ods" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".ods" "SlateOffice.ods"
  WriteRegStr HKCU "Software\Classes\.csv\OpenWithProgids" "SlateOffice.csv" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".csv" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".csv" "SlateOffice.csv"
  WriteRegStr HKCU "Software\Classes\.tsv\OpenWithProgids" "SlateOffice.tsv" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".tsv" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".tsv" "SlateOffice.tsv"
  WriteRegStr HKCU "Software\Classes\.pptx\OpenWithProgids" "SlateOffice.pptx" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".pptx" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".pptx" "SlateOffice.pptx"
  WriteRegStr HKCU "Software\Classes\.txt\OpenWithProgids" "SlateOffice.txt" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".txt" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".txt" "SlateOffice.txt"
  WriteRegStr HKCU "Software\Classes\.md\OpenWithProgids" "SlateOffice.md" ""
  WriteRegStr HKCU "Software\Classes\Applications\Slate Office.exe\SupportedTypes" ".md" ""
  WriteRegStr HKCU "Software\SlateOffice\Capabilities\FileAssociations" ".md" "SlateOffice.md"
  ; Tell Explorer the associations changed.
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro customUnInstall
  DeleteRegKey HKCU "Software\Classes\Applications\Slate Office.exe"
  DeleteRegKey HKCU "Software\SlateOffice"
  DeleteRegValue HKCU "Software\RegisteredApplications" "Slate Office"
  DeleteRegValue HKCU "Software\Classes\.pdf\OpenWithProgids" "SlateOffice.pdf"
  DeleteRegValue HKCU "Software\Classes\.docx\OpenWithProgids" "SlateOffice.docx"
  DeleteRegValue HKCU "Software\Classes\.doc\OpenWithProgids" "SlateOffice.doc"
  DeleteRegValue HKCU "Software\Classes\.odt\OpenWithProgids" "SlateOffice.odt"
  DeleteRegValue HKCU "Software\Classes\.rtf\OpenWithProgids" "SlateOffice.rtf"
  DeleteRegValue HKCU "Software\Classes\.html\OpenWithProgids" "SlateOffice.html"
  DeleteRegValue HKCU "Software\Classes\.xlsx\OpenWithProgids" "SlateOffice.xlsx"
  DeleteRegValue HKCU "Software\Classes\.xls\OpenWithProgids" "SlateOffice.xls"
  DeleteRegValue HKCU "Software\Classes\.ods\OpenWithProgids" "SlateOffice.ods"
  DeleteRegValue HKCU "Software\Classes\.csv\OpenWithProgids" "SlateOffice.csv"
  DeleteRegValue HKCU "Software\Classes\.tsv\OpenWithProgids" "SlateOffice.tsv"
  DeleteRegValue HKCU "Software\Classes\.pptx\OpenWithProgids" "SlateOffice.pptx"
  DeleteRegValue HKCU "Software\Classes\.txt\OpenWithProgids" "SlateOffice.txt"
  DeleteRegValue HKCU "Software\Classes\.md\OpenWithProgids" "SlateOffice.md"
!macroend
