{
  "name": "slate-office",
  "productName": "Slate Office",
  "version": "0.1.0",
  "description": "A clean, dark, offline office suite: PDF editor, documents, spreadsheets, text and images.",
  "author": "kadenw213-svg",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@fontsource/inter": "^5.1.0",
    "@lezer/highlight": "^1.2.1",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-font-family": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "codemirror": "^6.0.1",
    "docx": "^9.1.1",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.slate.office",
    "productName": "Slate Office",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Text File",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown File",
        "role": "Editor"
      },
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Editor"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Workbook",
        "role": "Editor"
      },
      {
        "ext": "ods",
        "name": "OpenDocument Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": "tsv",
        "name": "Tab-separated Values",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slate Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "kadenw213-svg",
        "repo": "slate-office",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/kadenw213-svg/slate-office",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadenw213-svg/slate-office.git"
  }
}
